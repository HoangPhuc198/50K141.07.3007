generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model BangLuong {
  Mabangluong      String             @id(map: "pk_bangluong") @db.Char(8)
  Tienthuong       Int                @default(0)
  Lydothuong       String?            @db.VarChar(200)
  Lydochinhsua     String?            @db.VarChar(200)
  Manv             String             @db.Char(8)
  Makyluong        String             @db.Char(8)
  KyLuong          KyLuong            @relation(fields: [Makyluong], references: [Makyluong], onDelete: NoAction, onUpdate: NoAction, map: "fk_bangluong_kyluong")
  NhanVien         NhanVien           @relation(fields: [Manv], references: [Manv], onDelete: NoAction, onUpdate: NoAction, map: "fk_bangluong_nhanvien")
  ChiTietBangLuong ChiTietBangLuong[]
  PhanHoiLuong     PhanHoiLuong[]

  @@unique([Manv, Makyluong], map: "uq_bangluong_nvky")
  @@index([Makyluong], map: "ix_bangluong_makyluong")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model CaLam {
